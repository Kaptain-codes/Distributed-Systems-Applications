# .env.example - Committed to Git

# Sets the prefix for all container/network/volume names
# (e.g. distributed_food_delivery_system-order-service-1)
COMPOSE_PROJECT_NAME=distributed_food_delivery_system

# Host Port Assignments (Ensures no collisions)
GATEWAY_PORT=8080
ORDER_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
ADMIN_SERVICE_PORT=8085
DELIVERY_SERVICE_PORT=8086
RESTAURANT_SERVICE_PORT=8087
ZOOKEEPER_PORT=2181
KAFKA_HOST_PORT=29092
CUSTOMER_DB_PORT=3307
RESTAURANT_DB_PORT=3308
PAYMENT_DB_PORT=3309
DELIVERY_DB_PORT=1437


ORDER_DB_PORT=27017
NOTIFICATION_DB_PORT=27018
ADMIN_DB_PORT=27019

# Global Default DB Usernames
MONGO_ROOT_USER=dev_admin

# Database names and application users
ORDER_DB_NAME=orders
ORDER_DB_USER=order_app
CUSTOMER_DB_NAME=customer
CUSTOMER_DB_USER=customer_app
RESTAURANT_DB_NAME=restaurant
RESTAURANT_DB_USER=restaurant_app
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment_app
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USER=notification_app
ADMIN_DB_NAME=admin
ADMIN_DB_USER=admin_app

# Passwords will be dynamically appended below by the PowerShell script...

# Compose engine control variables (not application config —
# read directly by the `docker compose` CLI, not referenced via ${} anywhere)
# Limits parallel image pulls; keep at 1 on slow or unstable connections.
COMPOSE_PARALLEL_LIMIT=1